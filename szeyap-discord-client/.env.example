# Copy to .env and fill in real values. Never commit .env.
# Get these from the Discord Developer Portal for the Szeyap application.

# Bot token (required to log in)
DISCORD_TOKEN=

# Application (client) ID of the Discord application (required to deploy commands)
APPLICATION_ID=

# Guild ID used for fast, guild-only command registration in development
# (required unless DEPLOY_GLOBAL=true)
DEV_GUILD_ID=

# Szeyap API base URL, without a trailing /api.
# Defaults to the live schan27/szeyap backend if unset.
API_BASE_URL=https://szeyap-backend-production.up.railway.app

# DEVELOPMENT uses http://szeyap-api:8000; anything else uses API_BASE_URL
NODE_ENV=PRODUCTION

# Set to true to register slash commands globally instead of in DEV_GUILD_ID
# (global registration can take up to an hour to propagate)
DEPLOY_GLOBAL=false

# Optional: winston log level (error, warn, info, debug)
LOG_LEVEL=info
